# Игнорировать системные файлы
.DS_Store
Thumbs.db

# Игнорировать данные (если добавите реальные CSV/JSON с чувствительной информацией)
data/
*.csv
*.json

# Игнорировать скомпилированные файлы Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Игнорировать конфигурацию IDE
.vscode/
.idea/
*.swp
*.swo

# Игнорировать отчеты (генерируются при запуске)
reports/
*.html
*.pdf
*.xlsx

# Игнорировать логи и временные файлы
*.log
tmp/
temp/

# Игнорировать файлы с паролями (если будете использовать)
.env
config.local.yaml
